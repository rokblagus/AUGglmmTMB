penOpt = AUGglmmTMBPenalty(autrepen =TRUE,plot=TRUE,ntaus=20),
control=AUGglmmTMBControl(fit_pGLM = TRUE,maxiter = 1,tol=1e-5,save_coef=TRUE)   )
extract_cov_matrices <- function(fit) {
vc <- VarCorr(fit)$cond
cov_list <- lapply(vc, function(x) {
as.matrix(x)
})
return(cov_list)
}
fit_mpl_3
fit_mpl_3$fit
extract_cov_matrices(fit_mpl_3$fit)
