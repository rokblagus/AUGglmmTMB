low = "blue",      # for negative scores
mid = "white",     # for zero
high = "red",      # for positive scores
midpoint = 0 ,      # center the color scale at 0
limits = c(min_score, max_score)
) +  theme_minimal()+
theme(axis.text.x = element_text(angle = 90, hjust = 1,vjust=0.5),axis.text.y = element_text(vjust = 0.5))+
