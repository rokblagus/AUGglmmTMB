mm<-matrix(unique(df$miRNA),nrow=3,byrow=TRUE)
df1<-df[which(df$miRNA%in%mm[1,]),]
df1$ILmRNA<-factor(as.character(df1$ILmRNA),levels=levels(factor(df$ILmRNA)))
df2<-df[which(df$miRNA%in%mm[2,]),]
df2$ILmRNA<-factor(as.character(df2$ILmRNA),levels=levels(factor(df$ILmRNA)))
df3<-df[which(df$miRNA%in%mm[3,]),]
df3$ILmRNA<-factor(as.character(df3$ILmRNA),levels=levels(factor(df$ILmRNA)))
min_score <- min(df1$Score, df2$Score, df3$Score, na.rm = TRUE)
max_score <- max(df1$Score, df2$Score, df3$Score, na.rm = TRUE)
p1_1_1<-ggplot(df1, aes(x = miRNA, y =ILmRNA , fill = Score)) +
geom_tile(color = "white") +
scale_y_discrete(drop = FALSE) +
