dd <- read_excel("Kopijaheat_paper_2013.1.xlsx")
dd<-as.data.frame(dd)
dd$date<-dd$date_of_measurement
dd$date[dd$date=="#NULL!"]<-NA
dd$date<-as.Date(as.numeric(dd$date),origin = "1899-12-30")
ddw <- read_excel("weather data_UTCI WBGT.xlsx",sheet="List1")
ddw<-as.data.frame(ddw)
ddw$date<-as.Date(ddw$date,origin = "1899-12-30")
dd<-dd[!is.na(dd$date),]
dd$temp<-NA
dd$humidity<-NA
dd$wind<-NA
dd$UTCI<-NA
dd$WBGT<-NA
##merge
for (i in 1:nrow(dd)){
idi<-which(ddw$"school ID"==dd[i,4]&ddw$date==dd$date[i])[2]
dd$temp[i]<-ddw[idi,3]
dd$humidity[i]<-ddw[idi,4]
dd$wind[i]<-ddw[idi,5]
dd$UTCI[i]<-ddw[idi,8]
dd$WBGT[i]<-ddw[idi,9]
}
#dd$temp[dd$temp>50]<-NA
df=3
df.age=3
my.sum<-function(x){
rr<-c(round(sum(!is.na(x)),0),min(x,na.rm=T),max(x,na.rm=T),round(mean(x,na.rm=T),2),round(sd(x,na.rm=T),2),round(median(x,na.rm=T),2),round(quantile(x,na.rm=T,prob=0.25),2),round(quantile(x,na.rm=T,prob=0.75),2))
names(rr)<-c("n","min","max","mean","sd","median","Q1","Q3")
rr
}
rr<-list()
iii=0
for (zz in c("MT30","MT60","M600Mcas","ATV","ATT","BMI","SUM_skinfold_7","body_surface","VO2maxMaharKvadrat","ZBMI"))  {
iii=iii+1
si.i<-matrix(NA,ncol=6+2+2,nrow=2*length(5:15))
colnames(si.i)<-c("spol","age","n","min","max","mean","sd","median","Q1","Q3")
jjj=0
for (ii in 1:2){
for (jj in 5:15){
jjj=jjj+1
di<-dd[which(dd$spol==ii&dd$StarLetR==jj),zz]
si<-my.sum(di)
si[1]<-round(si[1],0)
si<-c(ii,jj,si)
si.i[jjj,]<-si
}
}
rr[[iii]]<-si.i
}
warnings()
rr
